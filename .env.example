# Cherry-Up (GrowthAI) Environment Configuration

# Database
DATABASE_URL=postgresql://cherryup:cherryup_secret@localhost:5432/cherry_up

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (must be exactly 32 characters for AES-256)
ENCRYPTION_KEY=32-char-encryption-key-here!!

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Services
API_PORT=3001
API_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Cherry-Up

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@cherry-up.com

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
